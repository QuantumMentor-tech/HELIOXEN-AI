# ==============================================================================
# HELIOXEN AI — Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: In accordance with the HELIOXEN Threat Model (THR-001) and ADR-012,
# sensitive provider API keys are NEVER stored in plaintext environment files.
# All production secrets are managed exclusively via the native Windows
# Credential Manager (DPAPI safeStorage) in the Electron main process.
#
# This file is strictly for non-sensitive local development environment flags.
# ==============================================================================

# Application Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Renderer Dev Server Port (electron-vite default: 5173)
VITE_DEV_PORT=5173

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL=info

# Simulated Offline Mode for Development Testing (true | false)
VITE_SIMULATE_OFFLINE=false
